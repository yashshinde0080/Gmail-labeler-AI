{
  "version": 2,
  "builds": [
    {
      "src": "app/main.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "app/main.py"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/renew_watch",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/retry",
      "schedule": "0,15,30,45 * * * *"
    }
  ]
}
