# ─────────────────────────────────────────────
# Gmail AI Auto Labeler — Environment Variables
# ─────────────────────────────────────────────

# ── Groq AI ──────────────────────────────────
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=llama-3.1-8b-instant
GROQ_TIMEOUT=30
GROQ_MAX_RETRIES=3

# Free-tier resilience (llama-3.1-8b-instant allows ~30 requests/min)
GROQ_REQUESTS_PER_MINUTE=30
GROQ_RATE_LIMIT_MAX_WAIT=60

# ── Gmail OAuth2 ─────────────────────────────
# Get these from Google Cloud Console → APIs & Services → Credentials
GMAIL_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxx

# ── Database ─────────────────────────────────
DATABASE_URL=sqlite:///./data/gmail.db

# ── Scheduler ────────────────────────────────
POLL_INTERVAL_SECONDS=10
SCHEDULER_ENABLED=true
RETRY_MAX_ATTEMPTS=3
RETRY_BACKOFF_BASE=2

# ── Classification ───────────────────────────
CONFIDENCE_THRESHOLD=70
ARCHIVE_LOW_IMPORTANCE=true
STAR_HIGH_IMPORTANCE=true
ENABLE_NESTED_LABELS=false

# ── API ──────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=*
LOG_LEVEL=INFO

# ── Data Paths ───────────────────────────────
DATA_DIR=./data
LOG_DIR=./data/logs
